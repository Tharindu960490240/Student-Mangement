# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=3200

# Public URL of the React app (used in invitation / reset links and CORS)
FRONTEND_URL=http://localhost:4200
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# ---- Database (use a NEW database for AFC, e.g. afc_portal) ----
DATABASE_URL=postgres://afc_app:CHANGE_ME@localhost:5432/afc_portal
# Set true for managed/remote databases that require TLS
DB_SSL=false
# Keep true in production (verifies the server certificate)
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# ---- Private file storage (agreements and, later, student documents) ----
# Folder is created automatically. Keep it OUTSIDE any public web folder and back it up.
UPLOAD_DIR=storage
# Set to 1 when running behind a reverse proxy / load balancer (nginx, ALB)
TRUST_PROXY=0

# ---- Email ----
# console = print emails (links) in the terminal, good for local dev
# smtp    = send for real
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Australian Federation College
EMAIL_FROM=
SUPPORT_EMAIL=
# Public https URL of the logo for emails (optional)
LOGO_URL=

# ---- First admin (used only by: npm run seed:admin) ----
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=
